# ============================================================
# 排除清单
# ============================================================

# Chrome 远程调试实例的用户数据目录。
# 两条独立理由都必须排除：
#   1. 体积 200MB+，入库没有意义；
#   2. 它保存着 Steam 登录态 cookie —— 这属于凭证数据。
#      一旦提交并推送到远端，等同于把登录凭据一起公开，
#      而且 Git 历史里的东西删不干净，只能靠改密码补救。
.chrome-debug/

# 会话内工作记录与调试脚本目录。
# 含 steamid、调试过程与内部结论，不适合随源码一起公开。
.claude/
.claude.zip

# 旧版脚本备份（DOM/UI 路线，已废弃）
*.bak-*
